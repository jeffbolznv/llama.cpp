#version 450

#extension GL_EXT_control_flow_attributes : enable

// values of D per workgroup
layout(constant_id = 0) const uint BLOCK_SIZE = 32;
// number of parts that sum the splits in parallel, one per workgroup row
layout(constant_id = 1) const uint K_PARTS = 4;

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {float data_s[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter {
    uint D;
    uint ne1;
    uint ne2;
    uint ne3;
    uint k_num;
    uint sinks;
} p;

shared float tmp_m[K_PARTS][BLOCK_SIZE];
shared float tmp_l[K_PARTS][BLOCK_SIZE];
shared float tmp_o[K_PARTS][BLOCK_SIZE];

// add a split to the running max/sum/output; skip exp(0) so that a -inf max gives no NaN
void combine(inout float m_max, inout float L, inout float O, const float m, const float l, const float o) {
    const float m_new = max(m_max, m);
    const float s_old = m_max == m_new ? 1.0 : exp(m_max - m_new);
    const float s_new = m == m_new ? 1.0 : exp(m - m_new);
    L = L * s_old + l * s_new;
    O = O * s_old + o * s_new;
    m_max = m_new;
}

void main() {
    // Each workgroup handles BLOCK_SIZE values of D of a row
    const uint n = gl_WorkGroupID.x;
    const uint tx = gl_LocalInvocationID.x;
    const uint ty = gl_LocalInvocationID.y;
    const uint i2 = gl_WorkGroupID.z % p.ne2;
    const uint i3 = gl_WorkGroupID.z / p.ne2;

    const uint k_num = p.k_num;

    const uint l_offset = p.D * p.ne1 * p.ne2 * p.ne3 * k_num + p.ne1 * 2 * p.k_num * (i2 + p.ne2 * i3) + n;
    const uint m_offset = l_offset + p.ne1;
    const uint lm_stride = p.ne1 * 2;

    // D dimension is split across workgroups in the y dimension
    const uint d = tx + gl_WorkGroupID.y * BLOCK_SIZE;
    const uint o_offset = p.D * p.ne1 * p.k_num * (i2 + p.ne2 * i3) + p.D * n + min(d, p.D - 1);
    const uint o_stride = p.D * p.ne1;

    // this thread sums splits ty, ty + K_PARTS, ..., 4 loads at a time
    float m_max = -1.0/0.0;
    float L = 0.0;
    float O = 0.0;
    uint k = ty;
    for (; k + 3 * K_PARTS < k_num; k += 4 * K_PARTS) {
        float m[4], l[4], o[4];
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            m[j] = data_a[m_offset + (k + j * K_PARTS) * lm_stride];
            l[j] = data_a[l_offset + (k + j * K_PARTS) * lm_stride];
            o[j] = data_a[o_offset + (k + j * K_PARTS) * o_stride];
        }
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            combine(m_max, L, O, m[j], l[j], o[j]);
        }
    }
    for (; k < k_num; k += K_PARTS) {
        combine(m_max, L, O, data_a[m_offset + k * lm_stride], data_a[l_offset + k * lm_stride], data_a[o_offset + k * o_stride]);
    }

    // combine the parts
    tmp_m[ty][tx] = m_max;
    tmp_l[ty][tx] = L;
    tmp_o[ty][tx] = O;
    barrier();
    if (ty != 0 || d >= p.D) {
        return;
    }
    [[unroll]] for (uint y = 1; y < K_PARTS; ++y) {
        combine(m_max, L, O, tmp_m[y][tx], tmp_l[y][tx], tmp_o[y][tx]);
    }

    if (p.sinks != 0) {
        const float sink = data_s[n];

        float ms = 1.0f;
        float vs = 1.0f;

        if (sink > m_max) {
            ms = exp(m_max - sink);
        } else {
            vs = exp(sink - m_max);
        }

        L = L*ms + vs;
        O *= ms;
    }

    L = (L == 0.0) ? 0.0 : 1.0 / L;
    O *= L;

    const float FLT_MAX = uintBitsToFloat(0x7F7FFFFF);
    O = clamp(O, -FLT_MAX, FLT_MAX);

    data_d[(i3 * p.ne2 + i2) * p.ne1 * p.D + p.D * n + d] = O;
}
